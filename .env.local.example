AI_API_KEY=sk-ant-...
AI_MODEL=gemini-2.5-flash
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Frappe CRM (used by template plugins, e.g. prefill-destination) ---
FRAPPE_CRM_URL=https://erp.tendenciaevents.com
FRAPPE_CRM_API_KEY=
FRAPPE_CRM_API_SECRET=

# --- Public proposal share links (HMAC signing secret, stateless) ---
SHARE_LINK_SECRET=

# --- MCP server (/api/mcp): signs personal tokens from Settings → Connect Claude ---
# Required for the MCP endpoint to work. Rotating it revokes every MCP token.
MCP_TOKEN_SECRET=

# --- CRM integration: fixed bearer token for GET /api/proposals (read-only list) ---
# Choose a long random value (e.g. `openssl rand -hex 32`) and put the same value
# in the CRM's server script. Unset = only logged-in users can list proposals.
CRM_API_TOKEN=
