{
  "id": "divers-columns",
  "name": "Divers Columns Slide",
  "description": "Divers package as 3 or 4 image+text columns. Column count is decided by the provider from items.length (3 items -> 3 columns, 4 items -> 4 columns) and passed via `grid-columns`.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "title": { "type": "string" },
    "grid-columns": { "type": "string", "description": "Tailwind grid class, e.g. \"grid-cols-3\" or \"grid-cols-4\"." },
    "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "image": { "type": "string" },
          "paragraphes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
