{
  "id": "activity-detail",
  "name": "Activity Detail Slide",
  "description": "Detail slide, repeated once per selected activity (repeat over `activities`).",
  "requiredProps": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "video": { "type": "string", "format": "url" },
    "space": { "type": "string" },
    "timeframe": { "type": "string" },
    "number-of-participants": { "type": "string" },
    "difficulty": { "type": "string" },
    "images": {
      "type": "array",
      "items": { "type": "string", "format": "url" }
    }
  }
}
