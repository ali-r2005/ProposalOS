{
  "id": "destination",
  "title": "Destination Information",
  "description": "Details about the event destination and logistics",
  "fields": [
    {
      "key": "event-name",
      "label": "Nom de l'événement",
      "type": "text",
      "required": true,
      "placeholder": "p. ex. Sommet annuel du leadership 2025"
    },
    {
      "key": "event-type",
      "label": "Type d'événement",
      "type": "text",
      "required": true,
      "placeholder": "p. ex. Retraite d'entreprise, voyage incitatif, conférence"
    },
    {
      "key": "event-year",
      "label": "Année de l'événement",
      "type": "text",
      "required": true,
      "placeholder": "p. ex. 2025"
    },
    {
      "key": "event-dates",
      "label": "Dates de l'événement",
      "type": "text",
      "required": true,
      "placeholder": "p. ex. 15-18 juin 2025"
    },
    {
      "key": "destination",
      "label": "Destination",
      "type": "text",
      "required": true,
      "placeholder": "p. ex. Marrakech, Maroc"
    },
    {
      "key": "destination-image",
      "label": "URL de l'image de la destination ",
      "type": "url",
      "required": false,
      "placeholder": "https://exemple.com/destination.jpg"
    },
    {
      "key": "client-logo",
      "label": "URL du logo du client",
      "type": "url",
      "required": false,
      "placeholder": "https://exemple.com/logo.svg"
    },
    {
      "key": "participant-count",
      "label": "Nombre de participants",
      "type": "number",
      "required": true,
      "placeholder": "p. ex. 50"
    },
    {
      "key": "langue",
      "label": "Langue",
      "type": "text",
      "required": true,
      "placeholder": "p. ex. Français, arabe, anglais"
    },
    {
      "key": "travel-duration",
      "label": "Durée du voyage",
      "type": "text",
      "required": true,
      "placeholder": "p. ex. 3h 30m depuis Paris"
    },
    {
      "key": "stay-duration",
      "label": "Durée du séjour",
      "type": "text",
      "required": false,
      "placeholder": "p. ex. 4 jours / 3 nuits"
    },
    {
      "key": "formalities",
      "label": "Formalités",
      "type": "textarea",
      "required": false,
      "placeholder": "p. ex. Exigences de visa, validité du passeport, informations sur les vaccins"
    },
    {
      "key": "climate",
      "label": "Climat",
      "type": "text",
      "required": false,
      "placeholder": "p. ex. Ensoleillé, 25-30 °C en juin"
    }
  ]
}
