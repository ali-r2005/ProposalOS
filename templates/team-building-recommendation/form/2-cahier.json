    { "key": "handled-by", "label": "Traité par", "type": "text", "required": false },
    { "key": "option-date", "label": "Option pour", "type": "text", "required": false, "placeholder": "e.g. 23 OCTOBRE 2026" },
    { "key": "side-photo", "label": "Photo (right)", "type": "url", "required": false }
  ]
}
